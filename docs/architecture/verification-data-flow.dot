digraph verification_data_flow {
  graph [rankdir=TB, bgcolor="white", fontname="Arial", pad="0.25", nodesep="0.45", ranksep="0.7"];
  node [shape=box, style="rounded,filled", fillcolor="#f4f7fb", color="#385b8c", fontname="Arial", fontsize=11, margin="0.14,0.08"];
  edge [color="#536b85", fontname="Arial", fontsize=9, arrowsize=0.7];

  definition [label="Authored verification definition\n(selected configuration, world, spec, trial plan)", fillcolor="#fff4dc", color="#aa6b00"];
  lock [label="Reviewed dependency lock\n(versions, commits, digests)", fillcolor="#fff4dc", color="#aa6b00"];
  manifest [label="Pre-execution resolved run manifest\n(exact executable inputs)", fillcolor="#e7f3ff"];
  execution [label="Selected providers and verifier\n(execute trials)", fillcolor="#e6f5ea", color="#34734a"];
  evidence [label="Observed evidence bundle\n(partial and failed trials retained)", fillcolor="#fffdf0", color="#9a7c18"];
  assessment [label="Authoritative assessment\n(sufficiency, aggregation, grade, rationale)", fillcolor="#fffdf0", color="#9a7c18"];
  report [label="Rendered run and series report\n(supplied records, no new verdict)", fillcolor="#f0eafa", color="#714b9b"];
  publication [label="Optional publication destination\n(for example, GitHub Pages)", fillcolor="#f7f7f7", color="#666666"];

  definition -> manifest [label="resolve with"];
  lock -> manifest [label="pin"];
  manifest -> execution [label="execute"];
  execution -> evidence [label="observe and retain"];
  evidence -> assessment [label="evaluate"];
  assessment -> report [label="supply judgment"];
  evidence -> report [label="link provenance"];
  report -> publication [label="publish if selected"];
}
